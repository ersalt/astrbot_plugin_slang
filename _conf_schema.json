{
  "enabled": {
    "description": "总开关",
    "type": "bool",
    "default": true
  },
  "auto_learn": {
    "description": "是否自动学习群聊黑话",
    "type": "bool",
    "default": true
  },
  "learn_frequency": {
    "description": "每个群累计多少条消息触发一次提取",
    "type": "int",
    "default": 50,
    "min": 5,
    "max": 10000
  },
  "extract_max": {
    "description": "单次提取的最大条数",
    "type": "int",
    "default": 5,
    "min": 1,
    "max": 100
  },
  "inject_max": {
    "description": "单次注入的最大条数",
    "type": "int",
    "default": 3,
    "min": 1,
    "max": 50
  },
  "max_meaning_chars": {
    "description": "单条含义的字数上限，超出截断",
    "type": "int",
    "default": 200,
    "min": 20,
    "max": 1000
  },
  "provider_id": {
    "description": "提取用的模型 ID，留空用当前会话模型",
    "type": "string",
    "default": ""
  },
  "listen_private": {
    "description": "是否也学习私聊",
    "type": "bool",
    "default": false
  },
  "blacklist_groups": {
    "description": "不学习的群号，逗号分隔",
    "type": "string",
    "default": ""
  },
  "wiki_enable": {
    "description": "启用梗百科（关闭后隐藏侧栏与相关设置，也不参与注入）",
    "type": "bool",
    "default": true
  },
  "wiki_sync_enable": {
    "description": "自动同步梗Wiki（公开 API）",
    "type": "bool",
    "default": false
  },
  "wiki_sync_interval_days": {
    "description": "梗库自动同步间隔（天）",
    "type": "int",
    "default": 7,
    "min": 1,
    "max": 365
  },
  "wiki_sync_time": {
    "description": "每天几点几分检查同步，HH:MM",
    "type": "string",
    "default": "04:30"
  }
}
